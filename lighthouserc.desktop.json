{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3200",
      "url": ["http://localhost:3200/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ],
        "categories:seo": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ],
        "largest-contentful-paint": [
          "warn",
          { "maxNumericValue": 2500, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }
        ],
        "total-blocking-time": [
          "warn",
          { "maxNumericValue": 200, "aggregationMethod": "median-run" }
        ],
        "resource-summary:script:size": [
          "error",
          { "maxNumericValue": 120000, "aggregationMethod": "median-run" }
        ],
        "resource-summary:document:size": [
          "error",
          { "maxNumericValue": 60000, "aggregationMethod": "median-run" }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          { "maxNumericValue": 20000, "aggregationMethod": "median-run" }
        ],
        "resource-summary:font:size": [
          "error",
          { "maxNumericValue": 100000, "aggregationMethod": "median-run" }
        ],
        "resource-summary:third-party:count": [
          "error",
          { "maxNumericValue": 0, "aggregationMethod": "median-run" }
        ],
        "resource-summary:total:size": [
          "error",
          { "maxNumericValue": 350000, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}
